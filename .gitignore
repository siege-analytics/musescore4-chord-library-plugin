# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Override the user-level ~/.gitignore rule `test_*.py` (line 84) which
# silently drops pytest files from staging. The plugin's tests/ tree is
# tracked; this negation makes that explicit for any new test file.
# See siege-analytics/ellington-systems#1 post-error revision 2026-06-08
# for the originating incident.
!tests/test_*.py

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# MuseScore temp files
*.mscz~
*.mscx~

# Build artifacts
dist/
exports/
chords-db-import.json

# Master distillation pipeline — keep run state, LLM logs, and curated
# outputs in the repo (the audit trail is reproducible). The full raw
# transcript IS the book end-to-end and stays out of a public repo for
# copyright; everything else under runs/ commits cleanly.
pipelines/master-distillation/runs/*/raw-transcript.txt
